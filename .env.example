#  Hướng dẫn: Copy file này thành .env rồi điền giá trị
#  cp .env.example .env

# PostgreSQL
POSTGRES_DB=battlegame
POSTGRES_USER=
POSTGRES_PASSWORD=

# Server
SERVER_PORT=9001

# Network profile for LAN/Internet tests.
# Local default:
#   PUBLIC_HOST=127.0.0.1
# LAN example:
#   PUBLIC_HOST=192.168.1.10
# Internet example:
#   PUBLIC_HOST=your-domain-or-public-ip
PUBLIC_HOST=127.0.0.1
LB_PUBLIC_PORT=9090
GAME_PUBLIC_PORT=9999
GAME2_PUBLIC_PORT=10000

# SMTP mode: Mailpit or Real
SMTP_MODE=Mailpit
SMTP_FROM_NAME=BattleGame

# Mailpit mode - local inbox at http://localhost:8025, no username/password needed.
SMTP_MAILPIT_HOST=mailpit
SMTP_MAILPIT_PORT=1025
SMTP_MAILPIT_FROM_EMAIL=no-reply@battlegame.local
SMTP_MAILPIT_ENABLE_SSL=false

# Real mode - Gmail/Outlook/custom SMTP. Set SMTP_MODE=Real to use this group.
SMTP_REAL_HOST=smtp.gmail.com
SMTP_REAL_PORT=587
SMTP_REAL_FROM_EMAIL=your.email@gmail.com
SMTP_REAL_USERNAME=your.email@gmail.com
SMTP_REAL_PASSWORD=your_app_password
SMTP_REAL_ENABLE_SSL=true
